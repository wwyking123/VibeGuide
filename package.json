{
  "name": "vibeguide",
  "version": "0.2.0-alpha.14",
  "description": "Plain-language development conversations and a guide sidebar inside DeepSeek Harness",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": {
      "types": "./dist/guide/plugin.d.ts",
      "import": "./dist/guide/plugin.js"
    },
    "./preset": "./dist/guide/host/preset.js",
    "./communication": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-connection"
      ]
    }
  },
  "files": [
    "dist",
    "prompts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke:guide": "npm run build && node scripts/smoke-guide-desktop.mjs",
    "eval:sidebar": "npm run build && node scripts/eval-sidebar.mjs",
    "dev:guide": "npm run build && node scripts/smoke-guide-desktop.mjs --serve",
    "install:desktop": "npm run build && node scripts/install-desktop.mjs --home \"$HOME/.dsh\" --upgrade",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@types/node": "24.19.2",
    "@types/react": "18.3.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
