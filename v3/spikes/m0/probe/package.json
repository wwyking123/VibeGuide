{
  "name": "vg-probe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "M0 spike: prints the host APIs, slots and events a VibeGuide plugin would use. Not a product.",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-cordis-client-runner", "@deepseek-ai/dsh-client-ui-slots"]
    }
  }
}
